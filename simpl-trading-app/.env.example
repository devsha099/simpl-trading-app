# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard -> Settings -> API). Restart `expo start` after editing.
#
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time — this
# is the ANON key (safe for a client, protected by RLS), never the service
# role key. The service role key lives only in the backend's .env.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# RevenueCat public SDK keys (from the RevenueCat dashboard -> Project
# settings -> API keys). These are meant to be public/client-embedded,
# unlike the Alpaca keys — RevenueCat's own security model is "the SDK key
# can only make purchases and read entitlements for the identified user,"
# not a secret. Platform-specific: iOS and Android each get their own key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_ios_sdk_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_android_sdk_key_here
