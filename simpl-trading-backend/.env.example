# Copy this file to .env and fill in your sandbox credentials.
# NEVER commit .env. NEVER put these values in the mobile app.

PORT=4000

# Sandbox base URL. Change to https://broker-api.alpaca.markets only when going live.
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets

# Market data (quotes) host. Sandbox Broker API keys only work against the
# sandbox data host below — production data.alpaca.markets will 401 them.
# Change to https://data.alpaca.markets only when going live.
ALPACA_DATA_BASE_URL=https://data.sandbox.alpaca.markets

# From the Alpaca dashboard: API/Devs -> generate keys (Sandbox environment).
ALPACA_API_KEY_ID=your_sandbox_key_id_here
ALPACA_API_SECRET=your_sandbox_secret_here

# From the Supabase dashboard: Settings -> API. The SERVICE ROLE key bypasses
# RLS — it must only ever live here (backend), never in the mobile app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
