# Copy this file to .env and fill in your sandbox credentials.
# NEVER commit .env. NEVER put these values in the mobile app.

PORT=4000

# Sandbox base URL. Change to https://broker-api.alpaca.markets only when going live.
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets

# Market data (quotes) host. Sandbox Broker API keys only work against the
# sandbox data host below — production data.alpaca.markets will 401 them.
# Change to https://data.alpaca.markets only when going live.
ALPACA_DATA_BASE_URL=https://data.sandbox.alpaca.markets

# From the Alpaca dashboard: API/Devs -> generate keys (Sandbox environment).
ALPACA_API_KEY_ID=your_sandbox_key_id_here
ALPACA_API_SECRET=your_sandbox_secret_here

# From the Supabase dashboard: Settings -> API. The SERVICE ROLE key bypasses
# RLS — it must only ever live here (backend), never in the mobile app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Company profile + fundamentals for the stock screen's Company Info /
# Financials tabs — Alpaca has neither at any tier. Free key from
# finnhub.io/dashboard (no credit card). Free tier is personal/non-commercial
# use only per Finnhub's terms; confirm commercial terms before production.
FINNHUB_API_KEY=your_finnhub_api_key_here

# RevenueCat webhook — set this to the exact same string as the
# "Authorization header value" in the RevenueCat dashboard's webhook
# settings (Project settings -> Integrations -> Webhooks). Anyone who knows
# this value could POST fake "you're premium" events, so treat it like a
# secret, not a public key.
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_shared_secret_here

# The RevenueCat entitlement identifier that means "premium" in this app —
# whatever you name it in the RevenueCat dashboard. Defaults to "premium" if unset.
REVENUECAT_ENTITLEMENT_ID=premium

# Who may set X-Forwarded-For. Leave UNSET for local dev and any direct
# deploy. Behind a proxy/load balancer set it to that proxy's IP or CIDR
# (e.g. 10.0.0.0/8), or to a hop count (e.g. 1) on hosts with no stable
# proxy IP. Never "true" — the server refuses to start, because trusting
# the header from anyone lets a client forge a new IP per request and skip
# rate limiting entirely.
# TRUST_PROXY=1
